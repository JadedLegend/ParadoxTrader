[Unit]
Description=ParadoxTrader private owner dashboard (read-only, loopback)
After=network.target

[Service]
Type=simple
User=paradoxtrader
Group=paradoxtrader
WorkingDirectory=/opt/paradoxtrader/current
EnvironmentFile=/etc/paradoxtrader/dashboard.env
ExecStart=/opt/paradoxtrader/venv/bin/python deploy/private_dashboard.py serve --port 8080
Restart=on-failure
RestartSec=5

# Read-only inspection only: no outbound network, no writes outside its state.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite readers may need the -shm/-wal sidecars; the app itself is GET-only.
ReadWritePaths=/var/lib/paradoxtrader
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
